<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - EduExam Instructor Hub</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Bootstrap 4.6 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --primary-light: #eef2ff;
            --sidebar-bg: #ffffff;
            --body-bg: #f8fafc;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --danger: #ef4444;
            --success: #10b981;
            --warning: #f59e0b;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--body-bg);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* SIDEBAR STYLING */
        .app-sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 24px 16px;
            z-index: 1000;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 8px 24px;
            border-bottom: 1px solid #f1f5f9;
        }

        .brand-logo-icon {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }

        .brand-text h4 {
            font-size: 18px;
            font-weight: 800;
            margin: 0;
            color: #1e1b4b;
            letter-spacing: -0.5px;
        }

        .brand-text span {
            font-size: 11px;
            font-weight: 700;
            color: #6366f1;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .sidebar-section-title {
            font-size: 11px;
            font-weight: 700;
            color: #94a3b8;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            padding: 16px 12px 8px;
            margin: 0;
        }

        .sidebar-nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            color: #475569;
            font-size: 14px;
            font-weight: 600;
            border-radius: 10px;
            text-decoration: none;
            transition: all 0.2s ease;
            margin-bottom: 4px;
        }

        .sidebar-nav-item i {
            font-size: 16px;
            width: 20px;
            text-align: center;
            color: #64748b;
        }

        .sidebar-nav-item:hover {
            background-color: #f1f5f9;
            color: #1e293b;
            text-decoration: none;
        }

        .sidebar-nav-item.active {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: #ffffff;
            box-shadow: 0 6px 16px rgba(79, 70, 229, 0.25);
        }

        .sidebar-nav-item.active i {
            color: #ffffff;
        }

        .sidebar-footer-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 14px;
            font-size: 12px;
        }

        /* MAIN CONTENT STYLING */
        .app-main {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* HEADER / NAVBAR */
        .app-topbar {
            height: 70px;
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 36px;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .breadcrumb-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #64748b;
        }

        .breadcrumb-wrapper a {
            color: #64748b;
            text-decoration: none;
        }

        .breadcrumb-wrapper a:hover {
            color: var(--primary);
        }

        .breadcrumb-wrapper .active {
            color: #4f46e5;
            font-weight: 600;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .btn-bell {
            position: relative;
            background: none;
            border: none;
            color: #64748b;
            font-size: 18px;
            cursor: pointer;
            padding: 6px;
        }

        .btn-bell .badge-dot {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 8px;
            height: 8px;
            background-color: #ef4444;
            border-radius: 50%;
            border: 2px solid white;
        }

        .user-profile-badge {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 6px 12px;
            border-radius: 40px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            cursor: pointer;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #4f46e5;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        .user-info-text {
            line-height: 1.2;
        }

        .user-info-text .name {
            font-size: 13px;
            font-weight: 700;
            color: #0f172a;
        }

        .user-info-text .role {
            font-size: 11px;
            color: #64748b;
        }

        /* PAGE CONTENT WRAPPER */
        .page-body-container {
            padding: 30px 36px;
            flex-grow: 1;
        }

        /* GLOBAL CARDS & BADGES */
        .card-custom {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            transition: all 0.2s ease;
        }

        .badge-pill-custom {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>
    <!-- SIDEBAR -->
    <aside class="app-sidebar">
        <div>
            <!-- LOGO BRAND -->
            <div class="sidebar-brand">
                <div class="brand-logo-icon">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <div class="brand-text">
                    <h4>EduExam</h4>
                    <span>INSTRUCTOR HUB</span>
                </div>
            </div>

            <!-- NAVIGATION MENU -->
            <div class="mt-3">
                <p class="sidebar-section-title">QUẢN TRỊ KHẢO THÍ</p>
                <a href="/Exams" class="sidebar-nav-item @(ViewBag.ActiveMenu == "Index" ? "active" : "")">
                    <i class="fas fa-th-large"></i>
                    <span>Tổng quan</span>
                </a>
                <a href="/Exams" class="sidebar-nav-item">
                    <i class="fas fa-folder-open"></i>
                    <span>Ngân hàng đề thi</span>
                </a>
                <a href="/Exams/Create" class="sidebar-nav-item @(ViewBag.ActiveMenu == "Create" ? "active" : "")">
                    <i class="fas fa-file-circle-plus"></i>
                    <span>Tạo đề thi mới</span>
                </a>
                <a href="javascript:void(0);" class="sidebar-nav-item">
                    <i class="fas fa-calendar-check"></i>
                    <span>Đợt thi & Phòng thi</span>
                </a>
                <a href="javascript:void(0);" class="sidebar-nav-item">
                    <i class="fas fa-chart-line"></i>
                    <span>Chấm điểm & Thống kê</span>
                </a>

                <p class="sidebar-section-title mt-3">TÀI LIỆU & HỖ TRỢ</p>
                <a href="/Exams/DownloadSample?type=standard" class="sidebar-nav-item">
                    <i class="fas fa-file-word"></i>
                    <span>Hướng dẫn chuẩn hóa Word</span>
                </a>
            </div>
        </div>

        <!-- FOOTER SIDEBAR -->
        <div class="sidebar-footer-card">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <strong style="color: #0f172a;">EduExam Focus v2.4</strong>
                <span class="badge badge-success px-2 py-1" style="font-size: 10px; border-radius: 6px;">Chuẩn Bộ</span>
            </div>
            <p class="text-muted mb-0" style="font-size: 11px; line-height: 1.4;">
                Hệ thống số hóa đề thi tự động bảo mật cao.
            </p>
        </div>
    </aside>

    <!-- MAIN WRAPPER -->
    <main class="app-main">
        <!-- TOP NAVBAR -->
        <header class="app-topbar">
            <div class="breadcrumb-wrapper">
                <a href="/Exams"><i class="fas fa-home"></i></a>
                <span>/</span>
                <span>Cổng Giảng viên</span>
                <span>/</span>
                <span class="active">Quản lý Đề thi</span>
            </div>

            <div class="topbar-right">
                <button type="button" class="btn-bell" title="Thông báo">
                    <i class="far fa-bell"></i>
                    <span class="badge-dot"></span>
                </button>

                <div class="user-profile-badge">
                    <div class="user-avatar">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div class="user-info-text text-left">
                        <div class="name">TS. Nguyễn Minh Tuấn</div>
                        <div class="role">Khoa Công nghệ Thông tin</div>
                    </div>
                    <i class="fas fa-chevron-down text-muted" style="font-size: 10px; margin-left: 4px;"></i>
                </div>
            </div>
        </header>

        <!-- PAGE CONTENT -->
        <div class="page-body-container">
            @RenderBody()
        </div>
    </main>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
